{
    "name": "olegabr/eth-write",
    "description": "The write half of an EVM JSON-RPC stack: sending pre-signed transactions, state-changing contract calls, gas estimation and receipt waiting. No keys, no signing, no HTTP client of its own.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ethereum", "evm", "json-rpc", "send", "write"],
    "require": {
        "php": ">=8.1",
        "olegabr/eth-abi": "^0.2",
        "olegabr/eth-read": "^0.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../eth-abi",
            "options": {
                "symlink": true,
                "versions": {
                    "olegabr/eth-abi": "0.2.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../eth-read",
            "options": {
                "symlink": true,
                "versions": {
                    "olegabr/eth-read": "0.4.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../php-keccak",
            "options": {
                "symlink": true,
                "versions": {
                    "olegabr/keccak": "1.2.0"
                }
            }
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Ethereumico\\EthWrite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ethereumico\\EthWrite\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
